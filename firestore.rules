rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()    { return signedIn() && role() == 'admin'; }
    function isOperator() { return signedIn() && role() in ['operator', 'admin']; }

    // Users can only create themselves as passengers; admins assign other roles
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'passenger';
      allow update: if isAdmin() || (request.auth.uid == uid
                    && request.resource.data.role == resource.data.role);
    }

    // Bus profiles and operators: anyone logged in can look them up (Plate Lookup)
    match /buses/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /operators/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Trips: a passenger logs their own trips; operators/admins can review them
    match /trips/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOperator());
    }

    // Violations: logged by the app, readable for ratings, lookup and the dashboard
    match /violations/{id} {
      allow create: if signedIn();
      allow read: if signedIn();
    }

    // Ratings: calculated inside the app (as stated in the proposal)
    match /ratings/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}